---
import { SITE_TITLE } from '../consts';
import { cleanPath } from '../utils/path';

const links = [{ href: '/about', label: 'About' }];
const currentPath = cleanPath(Astro.url.pathname);
---

<header class="site-header">
	<a class="site-name" href="/">{SITE_TITLE}</a>
	<nav class="site-nav" aria-label="Primary">
		<ul role="list">
			{
				links.map(({ href, label }) => (
					<li>
						<a href={href} aria-current={currentPath === href ? 'page' : undefined}>
							{label}
						</a>
					</li>
				))
			}
		</ul>
	</nav>
	<button class="theme-toggle" type="button" hidden>
		<span class="when-light">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5a8.5 8.5 0 1 0 10.7 10.7Z"></path>
			</svg>
			<span class="visually-hidden">Switch to dark theme</span>
		</span>
		<span class="when-dark">
			<svg viewBox="0 0 24 24" aria-hidden="true">
				<circle cx="12" cy="12" r="4"></circle>
				<path
					d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4"
				></path>
			</svg>
			<span class="visually-hidden">Switch to light theme</span>
		</span>
	</button>
</header>

<script>
	const STORAGE_KEY = 'color-scheme';
	const meta = document.querySelector<HTMLMetaElement>('meta[name="color-scheme"]');
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle');
	const systemDark = matchMedia('(prefers-color-scheme: dark)');

	if (meta && button) {
		const apply = (scheme: string | null) => {
			meta.content = scheme ?? 'light dark';
		};

		button.hidden = false;

		button.addEventListener('click', () => {
			const system = systemDark.matches ? 'dark' : 'light';
			const rendered = meta.content === 'light' || meta.content === 'dark' ? meta.content : system;
			const target = rendered === 'dark' ? 'light' : 'dark';
			const override = target === system ? null : target;

			try {
				if (override) localStorage.setItem(STORAGE_KEY, override);
				else localStorage.removeItem(STORAGE_KEY);
			} catch {}

			apply(override);
		});

		addEventListener('storage', (event) => {
			if (event.key === STORAGE_KEY) apply(event.newValue);
			else if (event.key === null) apply(null);
		});
	}
</script>
